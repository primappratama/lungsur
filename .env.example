# Salin jadi .env.local, terus isi dari dashboard Supabase.

# Project Settings → API (atau tombol "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Pakai publishable key (sb_publishable_...). Anon key lama juga jalan.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Tombol "Connect" → ORMs / Connection string
# Transaction pooler (port 6543), dipakai aplikasi
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Session pooler (port 5432), dipakai buat migrasi
DIRECT_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Kosongin di lokal. Isi domain asli pas deploy, misalnya https://lungsur.id
NEXT_PUBLIC_SITE_URL=
